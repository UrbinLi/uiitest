# Target application URL. Run the application separately or use a test/staging deployment.
QA_BASE_URL=http://127.0.0.1:4174

# Local Midscene execution through the signed-in Codex app-server session.
MIDSCENE_MODEL_BASE_URL=codex://app-server
MIDSCENE_MODEL_NAME=gpt-5.4
MIDSCENE_MODEL_FAMILY=gpt-5

# GitHub Actions uses secrets with these MIDSCENE_MODEL_* names.
# For an OpenAI-compatible HTTP provider, set MIDSCENE_MODEL_API_KEY in GitHub Secrets.
